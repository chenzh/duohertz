{
  "name": "music-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter gateway --filter demo dev",
    "build": "pnpm -r build",
    "test": "bash scripts/harness.sh unit",
    "test:unit": "bash scripts/harness.sh unit",
    "test:integration": "bash scripts/harness.sh integration",
    "test:e2e": "bash scripts/harness.sh e2e",
    "test:mlx": "bash scripts/harness.sh mlx",
    "test:sa3": "bash scripts/mac-sa3-test.sh",
    "test:all": "bash scripts/harness.sh all",
    "harness": "bash scripts/harness.sh",
    "acceptance": "python3 scripts/acceptance-p0.py",
    "audit:beatscape": "python3 scripts/beatscape-audit.py --dir apps/beatscape/public --catalog apps/beatscape/public/catalog.json",
    "catalog:beatscape": "python3 scripts/beatscape-catalog-status.py",
    "cover:beatscape": "python3 scripts/beatscape-cover.py",
    "chart:beatscape": "python3 scripts/beatscape-chartgen.py",
    "ingest:beatscape-stream": "python3 scripts/beatscape-ingest-stream.py",
    "ingest:beatscape-stage2": "python3 scripts/beatscape-ingest-stage2.py",
    "ingest:beatscape-stage3": "python3 scripts/beatscape-ingest-stage3.py",
    "ingest:beatscape-stage4": "python3 scripts/beatscape-ingest-stage4.py",
    "ingest:beatscape-stage6": "python3 scripts/beatscape-ingest-stage6.py",
    "sync:beatscape-stage6": "python3 scripts/beatscape-stage6-sync-manifest.py",
    "pipeline:beatscape-stage3": "python3 scripts/beatscape-stage3-pipeline.py",
    "pipeline:beatscape-stage4": "python3 scripts/beatscape-stage4-pipeline.py",
    "pipeline:beatscape-stage6": "python3 scripts/beatscape-stage6-pipeline.py",
    "regenerate:beatscape-stage3": "python3 scripts/beatscape-regenerate-stage3.py",
    "stitch:beatscape-stream": "python3 scripts/beatscape-stitch-stream.py --all-stage1",
    "earcheck:beatscape": "python3 scripts/beatscape-earcheck.py",
    "dev:beatscape": "pnpm --filter @musicsaas/beatscape dev",
    "build:beatscape": "pnpm --filter @musicsaas/beatscape build",
    "dev:scapemusic": "pnpm --filter @musicsaas/scapemusic dev",
    "sync:scapemusic": "python3 scripts/scapemusic-sync-catalog.py",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@musicsaas/beatscape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cf": "tsc --noEmit && VITE_STREAM_APP_URL=https://scapemusic.pages.dev VITE_BASE=/ vite build",
    "deploy:cf": "npm run build:cf && npx --yes wrangler@4 pages deploy dist --project-name=beatscape --commit-dirty=true",
    "preview": "vite preview --host 127.0.0.1 --port 5175",
    "test": "vitest run",
    "test:prd": "vitest run src/acceptance/prdAcceptance.test.ts",
    "ingest:stage1": "python3 ../../scripts/beatscape-ingest-stage1.py",
    "generate:og": "python3 ../../scripts/beatscape-generate-og.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}

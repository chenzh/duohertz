# Cloudflare Pages 响应头。
#
# 背景：这些规则以前只写在 netlify.toml 里（Netlify 专属的 [[headers]] 格式），
# 而本项目实际部署在 Cloudflare Pages —— 也就是说线上从来没生效过：带内容哈希
# 的 JS/CSS 拿不到 immutable，回访用户每次都重新下载整个 bundle。
#
# 路径说明：build:cf 会把 VITE_BASE 设成 "/"，所以线上是 /assets/*、/catalog/*
# 而不是 /beatscape/assets/*。语法见 developers.cloudflare.com/pages/platform/headers

# Vite 给这些文件名加了内容哈希，内容一变文件名就变 —— 永久缓存是安全的。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 曲库会在原 track id 下重出谱面和音频，每次使用必须重验证。
# 发布构建还会给资产 URL 加内容哈希，避开旧版本已写入的 30 天浏览器缓存。
/catalog/*
  Cache-Control: public, max-age=0, must-revalidate

# catalog.json 会随曲库扩容而变，且文件名不变 —— 必须短缓存。
/catalog.json
  Cache-Control: public, max-age=0, must-revalidate

# 角色立绘文件名不含哈希，换图是原地覆盖，所以保守一些。
/characters/*
  Cache-Control: public, max-age=86400, must-revalidate

# HTML 入口永远回源：否则发版后用户拿不到新的资源引用，会被旧 index 卡住。
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/release.json
  Cache-Control: no-cache

# The browser must revalidate the worker itself so a new release can replace
# its shell list immediately. Manifest/icons change rarely but stay revalidatable.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

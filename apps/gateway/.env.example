# Gateway
GATEWAY_PORT=8080
API_KEY=change-me-in-production
# Optional secondary API key; never use the development default in production.
API_KEY_ALT=

# Set NODE_ENV=production for hosted Gateway deployments. Production rejects
# default API keys and disables the Demo BFF unless explicitly enabled.
# For a controlled trial behind access control, set both values below, using a
# dedicated key different from API_KEY/API_KEY_ALT. The BFF shares its key's quota.
# DEMO_BFF_ENABLED=true
# DEMO_API_KEY=
# Local development keeps the BFF enabled with a separate development key/quota.

DATABASE_URL=file:../../data/dev.db

ACE_WORKER_URL=http://192.168.0.199:8101
SA3_WORKER_URL=http://192.168.0.199:8102
WORKER_SECRET=optional-shared-secret

AUDIO_STORAGE_PATH=../../data/audio
AUDIO_TTL_HOURS=72

RATE_LIMIT_QPS=2
RATE_LIMIT_DAILY_JOBS=200
JOB_TIMEOUT_SEC=600

LOG_LEVEL=info
MOCK_WORKERS=false
